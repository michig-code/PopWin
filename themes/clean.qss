/* popwin: blur=none bar=36 dock=56 quick_on=#121212 ind=#D0D0D0 ind_active=#FFFFFF ind_light=#5A5A5A ind_active_light=#000000 */
* { font-family: "Inter", "Segoe UI Variable Text", "Segoe UI"; font-size: 13px; color: #EDEDED; outline: none; }

#Bar { background: #121212; }
#Panel, #Desklet { background: #181818; border: 1px solid #2C2C2C; border-radius: 6px; }

QPushButton, QToolButton { background: transparent; border: none; border-radius: 4px; padding: 4px 8px; }
QPushButton:hover, QToolButton:hover { background: #262626; }
QPushButton:pressed, QToolButton:pressed { background: #333333; }
QPushButton:checked { background: #EDEDED; color: #121212; }
QPushButton:disabled { color: #6E6E6E; }

#IconButton { font-size: 15px; padding: 4px 7px; }
#IconButton[active="true"] { color: #FFFFFF; background: #2B2B2B; }
#IconButton[alert="true"] { color: #FF6B5E; }
#IconButton[off="true"] { color: #7A7A7A; }
#UserLabel { font-weight: 600; padding: 0 10px; }
#WorkspaceChip { padding: 1px 8px; color: #8E8E8E; }
#WorkspaceChip[current="true"] { color: #FFFFFF; border-bottom: 2px solid #FFFFFF; border-radius: 0; }
#CenterLabel { color: #CFCFCF; }
#ClockTime { font-size: 13px; font-weight: 600; }
#ClockDate { font-size: 10px; color: #9A9A9A; }

#TaskButton { border-radius: 4px; padding: 3px; }
#TaskButton[focused="true"] { background: #262626; }
#StartButton { font-size: 19px; padding: 3px 10px; }
#Trash { font-size: 19px; padding: 3px 10px; }
#Trash[dropping="true"] { background: #EDEDED; color: #121212; }
#MediaBox { background: #1C1C1C; border-radius: 4px; }
#MediaTitle { font-weight: 600; font-size: 12px; }
#MediaArtist { font-size: 11px; color: #9A9A9A; }

#PanelTitle { font-size: 15px; font-weight: 600; }
#Muted { color: #9A9A9A; font-size: 12px; }
#AppTile { padding: 8px 4px; border-radius: 6px; font-size: 11px; }
#Danger { color: #FF6B5E; font-weight: 600; }
#Danger:hover { background: #FF6B5E; color: #121212; }

#SearchInput { background: #121212; border: 1px solid #3A3A3A; border-radius: 6px; padding: 10px 12px; font-size: 18px; selection-background-color: #EDEDED; selection-color: #121212; }
#SearchInput:focus { border-color: #8E8E8E; }
#Results { background: transparent; border: none; }
#Results::item { padding: 7px 10px; border-radius: 4px; }
#Results::item:selected { background: #2B2B2B; color: #FFFFFF; }
#Answer { background: #121212; border: 1px solid #2C2C2C; border-radius: 6px; padding: 10px; }

QMenu { background: #181818; border: 1px solid #2C2C2C; border-radius: 6px; padding: 5px; }
QMenu::item { background: transparent; border-radius: 4px; }
QMenu::item:selected { background: #2B2B2B; }
QMenu::item:disabled { color: #7A7A7A; }
QMenu::separator { height: 1px; background: #2C2C2C; margin: 5px 6px; }
#MenuChip { padding: 2px 8px; font-size: 12px; }
#MenuRowLabel { color: #9A9A9A; font-size: 12px; }

QSlider::groove:horizontal { height: 3px; background: #3A3A3A; }
QSlider::sub-page:horizontal { background: #EDEDED; }
QSlider::handle:horizontal { width: 12px; height: 12px; margin: -5px 0; border-radius: 6px; background: #FFFFFF; }
QProgressBar { background: #2B2B2B; border: none; max-height: 4px; }
QProgressBar::chunk { background: #EDEDED; }

#SettingsRoot, QDialog, QTabWidget::pane, QScrollArea, #SettingsPage { background: #121212; border: none; }
QTabWidget, QTabBar { background: #121212; }
QTabBar::tab { background: transparent; padding: 8px 14px; color: #9A9A9A; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { color: #FFFFFF; }
QTabBar::tab:selected { color: #FFFFFF; border-bottom: 2px solid #FFFFFF; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox, QListWidget { background: #181818; border: 1px solid #2C2C2C; border-radius: 4px; padding: 5px; }
QComboBox QAbstractItemView { background: #181818; selection-background-color: #2B2B2B; }
QPushButton#Primary { background: #EDEDED; color: #121212; font-weight: 600; padding: 6px 12px; }
QPushButton#Secondary { background: #262626; padding: 6px 12px; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 15px; height: 15px; border-radius: 3px; border: 1px solid #555555; background: #181818; }
QCheckBox::indicator:checked { background: #EDEDED; border-color: #EDEDED; }
QGroupBox { border: 1px solid #2C2C2C; border-radius: 6px; margin-top: 12px; padding: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #9A9A9A; }
QScrollBar:vertical { background: rgba(128, 128, 128, 0.12); width: 18px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(165, 165, 165, 0.8); border-radius: 7px; margin: 2px; min-height: 56px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; height: 0; }

#QuickTile { background: #262626; border: none; border-radius: 8px; padding: 8px 4px; font-size: 11px; }
#QuickTile:checked { background: #EDEDED; color: #121212; }
#QuickTile:disabled { color: #777777; }

#SettingsNav::item:selected, #SearchHits::item:selected { color: #EDEDED; }

QAbstractItemView QLineEdit { background: #181818; }

/* Hell-Modus */
[popMode="light"] QAbstractItemView QLineEdit { background: #FFFFFF; }
[popMode="light"] #SettingsNav::item:selected, [popMode="light"] #SearchHits::item:selected { color: #1A1A1A; }
[popMode="light"] #TaskButton[focused="true"] { background: #E6E6E6; }
[popMode="light"] #QuickTile { background: #EFEFEF; }
[popMode="light"] #QuickTile:checked { background: #1A1A1A; color: #FFFFFF; }
QMenu[popMode="light"], QMenu[popMode="light"]::item { color: #1A1A1A; }
[popMode="light"] QTabWidget, [popMode="light"] QTabBar { background: #FAFAFA; }
[popMode="light"] * { color: #1A1A1A; }
#Bar[popMode="light"] { background: #FFFFFF; }
#Panel[popMode="light"], #Desklet[popMode="light"], QMenu[popMode="light"] { background: #FFFFFF; border-color: #DDDDDD; }
[popMode="light"] QPushButton:hover, [popMode="light"] QToolButton:hover { background: #EFEFEF; }
[popMode="light"] QPushButton:checked { background: #1A1A1A; color: #FFFFFF; }
QMenu[popMode="light"]::item:selected { background: #EFEFEF; }
[popMode="light"] #IconButton[active="true"] { background: #E6E6E6; color: #000000; }
[popMode="light"] #ClockDate, [popMode="light"] #MediaArtist, [popMode="light"] #Muted, [popMode="light"] #MenuRowLabel, [popMode="light"] #CenterLabel { color: #5E5E5E; }
[popMode="light"] #WorkspaceChip { color: #8A8A8A; }
[popMode="light"] #WorkspaceChip[current="true"] { color: #000000; border-bottom-color: #000000; }
[popMode="light"] #SearchInput, [popMode="light"] #Answer { background: #FFFFFF; border-color: #CCCCCC; }
[popMode="light"] #Results::item:selected { background: #EFEFEF; color: #000000; }
[popMode="light"] #MediaBox { background: #F2F2F2; }
#SettingsRoot[popMode="light"], [popMode="light"] QTabWidget::pane, [popMode="light"] QScrollArea, [popMode="light"] #SettingsPage { background: #FAFAFA; }
[popMode="light"] QTabBar::tab { color: #6A6A6A; }
[popMode="light"] QTabBar::tab:selected { color: #000000; border-bottom-color: #000000; }
[popMode="light"] QLineEdit, [popMode="light"] QPlainTextEdit, [popMode="light"] QTextEdit, [popMode="light"] QSpinBox, [popMode="light"] QComboBox, [popMode="light"] QListWidget { background: #FFFFFF; border-color: #DDDDDD; }
[popMode="light"] QComboBox QAbstractItemView { background: #FFFFFF; selection-background-color: #EFEFEF; }
[popMode="light"] QPushButton#Primary { background: #1A1A1A; color: #FFFFFF; }
[popMode="light"] QPushButton#Secondary { background: #EAEAEA; }
[popMode="light"] QGroupBox { border-color: #DDDDDD; }
[popMode="light"] QCheckBox::indicator { background: #FFFFFF; border-color: #AAAAAA; }
[popMode="light"] QCheckBox::indicator:checked { background: #1A1A1A; }
[popMode="light"] QProgressBar { background: #E6E6E6; }
[popMode="light"] QProgressBar::chunk, [popMode="light"] QSlider::sub-page:horizontal, [popMode="light"] QSlider::handle:horizontal { background: #1A1A1A; }
[popMode="light"] QSlider::groove:horizontal { background: #CCCCCC; }
#NovaCard { background: rgba(255, 255, 255, 0.08); border-radius: 10px; }
[popMode="light"] #NovaCard { background: rgba(0, 0, 0, 0.06); }
