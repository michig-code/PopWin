/* Theme „Neon-Nacht“, erzeugt von PopWin (core/theme_maker.py). */
/* popwin: blur=acrylic tint=#0B081686 bar=36 dock=60 margin=6 rounded=1 quick_on=#8B5CF6 ind=#FF2FB3 ind_active=#FF2FB3 ind_light=#8B5CF6 ind_active_light=#FF2FB3 tiles=1 corner=18 */
* { font-family: "Segoe UI Variable Text", "Segoe UI"; font-size: 13px; color: #FFFFFF; outline: none; }

#Bar { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(18, 12, 36, 0.84), stop:1 rgba(11, 8, 22, 0.84)); border: 1px solid rgba(139, 92, 246, 0.465); border-top-color: rgba(255, 47, 179, 0.55); border-radius: 18px; }
#Panel, #Desklet { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(18, 12, 36, 0.84), stop:1 rgba(11, 8, 22, 0.84)); border: 1px solid rgba(139, 92, 246, 0.465); border-top-color: rgba(255, 47, 179, 0.55); border-radius: 18px; }

QPushButton, QToolButton { background: transparent; border: none; border-radius: 10px; padding: 3px 7px; }
QPushButton:hover, QToolButton:hover { background: rgba(255, 255, 255, 0.12); }
QPushButton:pressed, QToolButton:pressed { background: rgba(255, 255, 255, 0.2); }
QPushButton:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(255, 47, 179, 0.32)); }
QPushButton:disabled { color: rgba(255, 255, 255, 0.42); }

#IconButton { font-size: 16px; padding: 3px 6px; }
#IconButton[active="true"] { color: #FF2FB3; }
#IconButton[alert="true"] { color: #FF9D7A; }
#IconButton[off="true"] { color: rgba(255, 255, 255, 0.42); }
#UserLabel { font-weight: 600; padding: 0 8px; }
#WorkspaceChip { padding: 1px 8px; font-weight: 600; }
#WorkspaceChip[current="true"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); color: #FFFFFF; }
#CenterLabel { font-weight: 600; }
#ClockTime { font-size: 13px; font-weight: 600; }
#ClockDate { font-size: 10px; color: rgba(255, 255, 255, 0.68); }

#TaskButton { border-radius: 14px; padding: 3px; }
#TaskButton[focused="true"] { background: rgba(139, 92, 246, 0.22); }
#StartButton { font-size: 20px; padding: 3px 9px; }
#Trash { font-size: 20px; padding: 3px 9px; }
#Trash[dropping="true"] { background: rgba(139, 92, 246, 0.4); }
#MediaBox { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; }
#MediaTitle { font-weight: 600; font-size: 12px; }
#MediaArtist { font-size: 11px; color: rgba(255, 255, 255, 0.68); }

#PanelTitle { font-size: 16px; font-weight: 700; }
#Muted { color: rgba(255, 255, 255, 0.68); font-size: 12px; }
#AppTile { padding: 8px 4px; border-radius: 10px; font-size: 11px; }
#AppTile:hover { background: rgba(255, 255, 255, 0.12); }
#Danger { color: #FFB39B; font-weight: 600; }
#Danger:hover { background: rgba(255, 110, 80, 0.45); color: #FFFFFF; }

#SearchInput { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(139, 92, 246, 0.465); border-radius: 14px; padding: 10px 14px; font-size: 18px; selection-background-color: rgba(139, 92, 246, 0.4); }
#SearchInput:focus { border-color: #FF2FB3; }
#Results { background: transparent; border: none; }
#Results::item { padding: 7px 10px; border-radius: 10px; }
#Results::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(255, 47, 179, 0.32)); color: #FFFFFF; }
#Answer { background: rgba(255, 255, 255, 0.06); border-radius: 10px; padding: 10px; }

QMenu { background: #0E0A1D; border: 1px solid rgba(139, 92, 246, 0.465); border-radius: 10px; padding: 6px; }
QMenu::item { background: transparent; border-radius: 10px; padding: 5px 18px 5px 10px; }
QMenu::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(255, 47, 179, 0.32)); }
QMenu::item:disabled { color: rgba(255, 255, 255, 0.42); }
QMenu::separator { height: 1px; background: rgba(255, 255, 255, 0.1); margin: 5px 8px; }
#MenuChip { padding: 2px 8px; font-size: 12px; }
#MenuRowLabel { color: rgba(255, 255, 255, 0.68); font-size: 12px; }

QSlider::groove:horizontal { height: 4px; background: rgba(255, 255, 255, 0.2); border-radius: 2px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); border-radius: 2px; }
QSlider::handle:horizontal { width: 16px; height: 16px; margin: -6px 0; border-radius: 8px; background: #FFFFFF; border: 2px solid #FF2FB3; }
QProgressBar { background: rgba(255, 255, 255, 0.12); border: none; border-radius: 3px; max-height: 6px; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); border-radius: 3px; }

#SettingsRoot, QDialog { background: #0E0A1D; }
QTabWidget::pane, QScrollArea, #SettingsPage { background: #0E0A1D; border: none; }
QTabWidget, QTabBar { background: #0E0A1D; }
QTabBar::tab { background: transparent; padding: 8px 14px; border-bottom: 2px solid transparent; }
QTabBar::tab:hover { background: rgba(255, 255, 255, 0.06); }
QTabBar::tab:selected { border-bottom: 2px solid #FF2FB3; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox, QListWidget { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 10px; padding: 5px; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QComboBox:focus { border-color: #8B5CF6; }
QComboBox QAbstractItemView { background: #201B31; selection-background-color: rgba(139, 92, 246, 0.4); }
QAbstractItemView QLineEdit { background: #201B31; }
QPushButton#Primary { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); color: #FFFFFF; font-weight: 700; padding: 7px 16px; border: none; border-radius: 14px; }
QPushButton#Primary:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF2FB3, stop:1 #8B5CF6); }
QPushButton#Secondary { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(139, 92, 246, 0.465); padding: 7px 16px; border-radius: 14px; }
QPushButton#Secondary:hover { background: rgba(255, 255, 255, 0.12); border-color: #FF2FB3; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border-radius: 5px; border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.06); }
QCheckBox::indicator:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); border-color: #FF2FB3; }
QGroupBox { border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; margin-top: 12px; padding: 10px; background: rgba(255, 255, 255, 0.06); }
QGroupBox::title { subcontrol-origin: margin; left: 10px; color: #FF2FB3; font-weight: 600; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 0; }
QScrollBar::handle:vertical { background: rgba(139, 92, 246, 0.4); border-radius: 5px; margin: 2px; min-height: 48px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; height: 0; }

#QuickTile { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; padding: 8px 4px; font-size: 11px; }
#QuickTile:hover { border-color: rgba(255, 47, 179, 0.55); }
#QuickTile:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #8B5CF6, stop:1 #FF2FB3); color: #FFFFFF; border-color: #FF2FB3; }
#QuickTile:disabled { color: rgba(255, 255, 255, 0.42); }
#SettingsNav::item:selected, #SearchHits::item:selected { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(255, 47, 179, 0.32)); color: #FFFFFF; }
#NovaCard { background: rgba(255, 255, 255, 0.06); border-radius: 10px; }

/* Kacheln um die Icons der Taskbar */
#Bar #TaskButton, #Bar #StartButton, #Bar #Trash { border: 1px solid rgba(255, 255, 255, 0.1); padding: 5px; margin: 1px 2px; background: rgba(255, 255, 255, 0.06); }
#Bar #TaskButton { border-radius: 14px; } #Bar #StartButton, #Bar #Trash { border-radius: 14px; padding-left: 8px; padding-right: 8px; }
#Bar #TaskButton:hover, #Bar #StartButton:hover, #Bar #Trash:hover { background: rgba(255, 255, 255, 0.12); border-color: rgba(255, 47, 179, 0.55); }
#Bar #TaskButton:pressed, #Bar #StartButton:pressed, #Bar #Trash:pressed { background: rgba(255, 255, 255, 0.2); }
#Bar #TaskButton[focused="true"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(139, 92, 246, 0.32), stop:1 rgba(255, 47, 179, 0.32)); border: 1px solid #FF2FB3; }
#Bar #Trash[dropping="true"] { border: 2px solid #FF2FB3; }

/* Hell-Modus */
[popMode="light"] * { color: #14171D; }
#Bar[popMode="light"], #Panel[popMode="light"], #Desklet[popMode="light"] { background: rgba(255, 255, 255, 0.6); border-color: rgba(139, 92, 246, 0.4); }
QMenu[popMode="light"] { background: #FFFFFF; border-color: rgba(139, 92, 246, 0.4); }
QMenu[popMode="light"], QMenu[popMode="light"]::item { color: #14171D; }
QMenu[popMode="light"]::item:selected { background: rgba(139, 92, 246, 0.22); color: #14171D; }
[popMode="light"] #Results::item:selected, [popMode="light"] #SettingsNav::item:selected, [popMode="light"] #SearchHits::item:selected { background: rgba(139, 92, 246, 0.22); color: #14171D; }
#SettingsRoot[popMode="light"], [popMode="light"] QTabWidget::pane, [popMode="light"] QScrollArea, [popMode="light"] #SettingsPage, [popMode="light"] QTabWidget, [popMode="light"] QTabBar { background: #F3F1F8; }
[popMode="light"] QLineEdit, [popMode="light"] QPlainTextEdit, [popMode="light"] QTextEdit, [popMode="light"] QSpinBox, [popMode="light"] QComboBox, [popMode="light"] QListWidget, [popMode="light"] #SearchInput { background: #FFFFFF; border-color: rgba(0, 0, 0, 0.18); }
[popMode="light"] QComboBox QAbstractItemView, [popMode="light"] QAbstractItemView QLineEdit { background: #FFFFFF; }
[popMode="light"] #Muted, [popMode="light"] #ClockDate, [popMode="light"] #MediaArtist, [popMode="light"] #MenuRowLabel { color: rgba(0, 0, 0, 0.62); }
[popMode="light"] QPushButton:hover, [popMode="light"] QToolButton:hover { background: rgba(0, 0, 0, 0.08); }
[popMode="light"] QGroupBox, [popMode="light"] #QuickTile, [popMode="light"] #MediaBox, [popMode="light"] #Bar #TaskButton, [popMode="light"] #Bar #StartButton, [popMode="light"] #Bar #Trash { background: rgba(0, 0, 0, 0.04); border-color: rgba(0, 0, 0, 0.12); }
[popMode="light"] QPushButton#Primary, [popMode="light"] #QuickTile:checked, [popMode="light"] #WorkspaceChip[current="true"] { color: #FFFFFF; }
[popMode="light"] QPushButton#Secondary { background: rgba(0, 0, 0, 0.06); }
[popMode="light"] #IconButton[off="true"] { color: rgba(0, 0, 0, 0.42); }
